FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    NPM_CONFIG_MAXSOCKETS=5
COPY sisonke-admin-dashboard/package*.json ./
RUN NODE_OPTIONS="--dns-result-order=ipv4first" npm ci --no-audit --no-fund
COPY sisonke-admin-dashboard ./
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /usr/share/caddy
COPY sisonke-admin-dashboard/Caddyfile /etc/caddy/Caddyfile
